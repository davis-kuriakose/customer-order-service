# ============================================================
#  customer-order-service — environment variable reference
#  Copy this file to .env and fill in values for local use.
#  docker-compose.yml reads these via ${VAR:-default} syntax.
#  Never commit .env — it is already in .gitignore.
# ============================================================

# ------ order-service ----------------------------------------

# API key callers must supply in the X-API-Key header for order-service
APP_API_KEY=dev-api-key

# ------ catalog-service --------------------------------------

# API key callers must supply in the X-API-Key header for catalog-service.
# Also used by order-service when it calls catalog-service internally.
CATALOG_API_KEY=internal-catalog-key

# ------ Swagger / OpenAPI ------------------------------------

# Controls whether Swagger UI (/swagger-ui.html) and the OpenAPI spec
# (/v3/api-docs) are exposed at runtime.
#
# Default in application.yml is now FALSE (safe for production).
# Set to true here to enable during local development and testing.
# Applied to both order-service and catalog-service.
SWAGGER_ENABLED=true

# ------ Database passwords -----------------------------------

# Password for the order-service PostgreSQL database.
# Production: set to a strong random value. Never commit the real value.
ORDER_DB_PASSWORD=order_pass

# Password for the catalog-service PostgreSQL database.
# Production: set to a strong random value. Never commit the real value.
CATALOG_DB_PASSWORD=catalog_pass
